{
  "id": "campus-network-auth",
  "name": "校园网认证",
  "version": "1.2.0",
  "description": "通过固定认证入口自动连接北师大校园网，支持失败重试和独立于 BNU-ToolBox 的用户级开机自启。",
  "entry": "plugin.py",
  "config_ui": "ui.html",
  "config_schema": [
    {
      "key": "username",
      "label": "校园网账号",
      "type": "string",
      "default": ""
    },
    {
      "key": "password",
      "label": "校园网密码",
      "type": "password",
      "default": ""
    },
    {
      "key": "max_attempts",
      "label": "最大尝试次数",
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 100,
      "step": 1
    },
    {
      "key": "retry_interval",
      "label": "重试间隔（秒）",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 300,
      "step": 1
    },
    {
      "key": "request_timeout",
      "label": "请求超时（秒）",
      "type": "number",
      "default": 10,
      "min": 2,
      "max": 60,
      "step": 1
    },
    {
      "key": "autostart",
      "label": "开机自启",
      "type": "bool",
      "default": false,
      "hint": "注册当前用户的系统自启项，运行时不依赖 BNU-ToolBox 宿主"
    }
  ]
}
